{
  "name": "@opeoginni/github-copilot-openai-compatible",
  "version": "1.0.0",
  "description": "GitHub Copilot API OpenAI-Compatible Provider for AI SDK",
  "license": "MIT",
  "git": "https://github.com/OpeOginni/github-copilot-openai-compatible",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpeOginni/github-copilot-openai-compatible.git"
  },
  "bugs": {
    "url": "https://github.com/OpeOginni/github-copilot-openai-compatible/issues"
  },
  "homepage": "https://github.com/OpeOginni/github-copilot-openai-compatible#readme",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/OpeOginni"
  },
  "author": "Opeyemi Oginni",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:example": "npm run build && npx tsx examples/test-usage.ts",
    "generate-token": "npx tsx examples/generate-token.ts",
    "pack:test": "npm run build && npm pack"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.2",
    "@ai-sdk/provider": "^3.0.1",
    "@ai-sdk/provider-utils": "^4.0.2"
  },
  "devDependencies": {
    "tsup": "^7.1.0",
    "typescript": "^5.1.6",
    "vitest": "^0.34.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "github",
    "copilot",
    "openai",
    "compatible",
    "llm"
  ]
}
